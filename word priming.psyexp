  <Flow>
    <Routine name="instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'study_test': 'book'}, {'study_test': 'cushion'}, {'study_test': 'phone'}, {'study_test': 'marble'}, {'study_test': 'board'}, {'study_test': 'laptop'}, {'study_test': 'chart'}, {'study_test': 't-shirt'}, {'study_test': 'mouse'}, {'study_test': 'pastry'}, {'study_test': 'case'}, {'study_test': 'cruise'}, {'study_test': 'police'}, {'study_test': 'keys'}, {'study_test': 'poster'}]" valType="str"/>
